pragma runLim, 0

// Helper function to log errors safely in batch mode
void logError(string msg) {
    print "ERROR: " msg "\n"
    halt
}

// Function to safely escape strings and append directly to the main buffer.
void appendEscapedJSON(Buffer b, string s) {
    int i
    for (i = 0; i < length(s); i++) {
        char c = s[i]
        if (c == '"') { b += "\\\"" }
        else if (c == '\\') { b += "\\\\" }
        else if (c == '\n') { b += "\\n" }
        else if (c == '\r') { b += "\\r" }
        else if (c == '\t') { b += "\\t" }
        else { b += c }
    }
}

// Helper function to extract only the trailing numeric digits from a DOORS ID
string extractNumericId(string fullId) {
    if (null fullId) return ""
    int len = length(fullId)
    int i = len - 1
    
    // Scan backward to find where the numbers start
    while (i >= 0) {
        char c = fullId[i]
        if (c < '0' || c > '9') {
            break
        }
        i--
    }
    
    // Extract the substring containing only trailing digits
    int numStart = i + 1
    if (numStart >= len) return ""
    return fullId[numStart:(len - 1)]
}

// Explicitly opens all linked modules in the background
void openLinkedModules(Module mmm, Skip skipInlinks) {
    Object o
    LinkRef lr
    Link outLink
    ModuleVersion mvSource = null
    ModuleVersion mvTarget = null
    Module modLnk = null
    string linkFullName = ""

    for o in entire mmm do {
        if (isDeleted(o) || null o) continue

        // Pre-open Incoming Modules
        for lr in all(o<-"*") do {
            mvSource = sourceVersion lr
            linkFullName = fullName(source lr)
            modLnk = data mvSource
            
            if (null modLnk) {
                modLnk = load(mvSource, false)
            }
            if (!null modLnk && !find(skipInlinks, linkFullName)) {
                put(skipInlinks, linkFullName, modLnk)
            }
        }

        // Pre-open Outgoing Modules
        for outLink in all o->"*" do {
            mvTarget = targetVersion outLink
            linkFullName = fullName(target outLink)
            modLnk = data mvTarget
            
            if (null modLnk) {
                modLnk = load(mvTarget, false)
            }
            if (!null modLnk && !find(skipInlinks, linkFullName)) {
                put(skipInlinks, linkFullName, modLnk)
            }
        }
    }
}

// Closes background modules and removes tracking structures
void closeLinkedModules(Skip skipInlinks) {
    Module tempMod = null
    for tempMod in skipInlinks do {
        if (!null tempMod) {
            close(tempMod)
        }
    }
    delete(skipInlinks)
}

string modulePath = "%MODULE_PATH%"
bool includeDeleted = %INCLUDE_DELETED%

Module m = read(modulePath, false, true)

if (null m) {
    logError("Could not open module at path: " modulePath)
}

// Initialize link tracking structures
Skip skipInlinks = createString()
openLinkedModules(m, skipInlinks)

string outputFilePath = "%OUTPUT_FILE_PATH%"
Stream outStream = write(outputFilePath)

if (null outStream) {
    closeLinkedModules(skipInlinks)
    close(m)
    logError("Could not open file for writing.")
}

Buffer tempBuf = create()
tempBuf += "[\n"
outStream << tempBuf
setempty(tempBuf)

bool firstObj = true
Object o
AttrDef ad
AttrType at

for o in all m do {
    // Skip deleted objects unless the Python CLI passed --include-deleted
    if (!includeDeleted && isDeleted(o)) continue
    
    if (!firstObj) { outStream << ",\n" }
    firstObj = false
    
    tempBuf += "  {\n"
    bool firstAttr = true
    
    for ad in m do {
        if (!ad.object) continue
        
        if (!firstAttr) { tempBuf += ",\n" }
        firstAttr = false
        
        string attrName = ad.name
        at = ad.type
        
        // Use probeAttr_ to safely extract dynamic attribute names
        string val = probeAttr_(o, attrName)
        
        tempBuf += "    \""
        tempBuf += attrName
        tempBuf += "\": "
        
        // Handle specialized True/False enumerations (output native boolean)
        bool isBoolEnum = false
        if (at.type == attrEnumeration && at.size == 2 && !ad.multi) {
            if ((at.strings[0] == "True" && at.strings[1] == "False") ||
                (at.strings[0] == "False" && at.strings[1] == "True")) {
                isBoolEnum = true
            }
        }
        
        if (isBoolEnum) {
            if (val == "True") { tempBuf += "true" }
            else if (val == "False") { tempBuf += "false" }
            else { tempBuf += "null" }
        }
        // Handle native numbers
        else if (at.name == "Integer" || at.name == "Real") {
            if (val == "") { tempBuf += "null" }
            else { tempBuf += val }
        }
        // Handle multi-select enumerations
        else if (at.type == attrEnumeration && ad.multi) {
            if (val == "") { 
                tempBuf += "null" 
            } else {
                tempBuf += "["
                bool firstItem = true
                int startIdx = 0
                int i
                
                // Manually split the string by newlines (\n) to build the JSON array
                for (i = 0; i < length(val); i++) {
                    if (val[i] == '\n') {
                        if (!firstItem) { tempBuf += ", " }
                        tempBuf += "\""
                        if (i > startIdx) {
                            appendEscapedJSON(tempBuf, val[startIdx:i-1])
                        }
                        tempBuf += "\""
                        firstItem = false
                        startIdx = i + 1
                    }
                }
                
                // Process the final element after the last newline
                if (startIdx < length(val)) {
                    if (!firstItem) { tempBuf += ", " }
                    tempBuf += "\""
                    appendEscapedJSON(tempBuf, val[startIdx:length(val)-1])
                    tempBuf += "\""
                }
                
                tempBuf += "]"
            }
        }
        // Handle text and standard drop-down enumerations safely
        else {
            tempBuf += "\""
            appendEscapedJSON(tempBuf, val)
            tempBuf += "\""
        }
        
        outStream << tempBuf
        setempty(tempBuf)
    }
    
    // --- Out-links Extraction (Using Object Handles) ---
    tempBuf += ",\n    \"out_links\": ["
    bool firstOutLink = true
    Link l
    for l in all(o -> "*") do {
        Object tgt = target(l)
        if (null tgt) continue
        
        if (!firstOutLink) { tempBuf += ", " }
        firstOutLink = false
        
        string tgtModName = fullName(module(tgt))
        string lnkModName = fullName(module(l))
        string shortId = extractNumericId(identifier(tgt))
        
        tempBuf += "{\"link_module\": \""
        appendEscapedJSON(tempBuf, lnkModName)
        tempBuf += "\", \"target_module\": \""
        appendEscapedJSON(tempBuf, tgtModName)
        tempBuf += "\", \"target_id\": " 
        if (shortId == "") { tempBuf += "null" } else { tempBuf += shortId }
        tempBuf += "}"
    }
    tempBuf += "]"

    // --- In-links Extraction (Using Object Handles) ---
    tempBuf += ",\n    \"in_links\": ["
    bool firstInLink = true
    
    for l in all(o <- "*") do {
        Object src = source(l)
        if (null src) continue
        
        if (!firstInLink) { tempBuf += ", " }
        firstInLink = false
        
        string srcModName = fullName(module(src))
        string lnkModName = fullName(module(l))
        string shortId = extractNumericId(identifier(src))
        
        tempBuf += "{\"link_module\": \""
        appendEscapedJSON(tempBuf, lnkModName)
        tempBuf += "\", \"source_module\": \""
        appendEscapedJSON(tempBuf, srcModName)
        tempBuf += "\", \"source_id\": " 
        if (shortId == "") { tempBuf += "null" } else { tempBuf += shortId }
        tempBuf += "}"
    }
    tempBuf += "]"
    
    tempBuf += "\n  }"
    outStream << tempBuf
    setempty(tempBuf)
}

tempBuf += "\n]\n"
outStream << tempBuf

delete(tempBuf)
close(outStream)

// Safely close background modules before shutting down
closeLinkedModules(skipInlinks)
close(m)

halt