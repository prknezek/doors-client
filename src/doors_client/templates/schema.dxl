pragma runLim, 0

// Helper function to log errors safely in batch mode without freezing DOORS
void logError(string msg) {
    print "ERROR: " msg "\n"
    halt
}

// Inject the path from Python
string modulePath = "%MODULE_PATH%"

// Open the module as read-only
Module m = read(modulePath, false, true)

if (null m) {
    logError("Could not open module at path: " modulePath)
}

string outputFilePath = "%OUTPUT_FILE_PATH%"
Stream outStream = write(outputFilePath)

if (null outStream) {
    logError("Could not open file for writing. Check your folder permissions and path.")
}

AttrDef ad
AttrType at
Buffer tempBuf = create()

// Helper function to map DOORS data types to JSON Schema types
string mapJsonType(string doorsType) {
    if (doorsType == "Integer") return "integer"
    if (doorsType == "Real")    return "number"
    if (doorsType == "Boolean") return "boolean"
    return "string"
}

// Start building the formal JSON Schema
tempBuf += "{\n"
tempBuf += "  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n"
tempBuf += "  \"title\": \"DoorsObject\",\n"
tempBuf += "  \"type\": \"object\",\n"
tempBuf += "  \"properties\": {\n"

outStream << tempBuf
setempty(tempBuf)

bool firstProp = true

for ad in m do {
    if (null ad) continue
    if (ad.object) {
        
        at = ad.type
        if (null at) continue
        
        if (!firstProp) { outStream << ",\n" }
        firstProp = false
        
        string attrName = ad.name
        string jsonType = mapJsonType(at.name)
        
        tempBuf += "    \""
        tempBuf += attrName
        tempBuf += "\": {\n"
        
        // --- HANDLE ENUMERATIONS (Drop-down lists in DOORS) ---
        if (at.type == attrEnumeration) {

            // Check if multiple values are allowed
            bool isMulti = ad.multi
            
            // Check if it's strictly a True/False boolean
            bool isBoolEnum = false
            if (at.size == 2) {
                if ((at.strings[0] == "True" && at.strings[1] == "False") ||
                    (at.strings[0] == "False" && at.strings[1] == "True")) {
                    isBoolEnum = true
                }
            }
            
            if (isBoolEnum) {
                // DOORS unassigned booleans export as null. Allow it.
                tempBuf += "      \"type\": [\"boolean\", \"null\"]\n"
            } else if (isMulti) {
                // Multi-select enumeration -> Array of strict choices
                tempBuf += "      \"type\": [\"array\", \"null\"],\n"
                tempBuf += "      \"items\": {\n"
                tempBuf += "        \"type\": \"string\",\n"
                tempBuf += "        \"enum\": ["
                
                int i
                for (i = 0; i < at.size; i++) {
                    if (i > 0) { tempBuf += ", " }
                    tempBuf += "\""
                    tempBuf += at.strings[i]
                    tempBuf += "\""
                }
                
                // Add empty string in case of blank selections
                tempBuf += ", \"\"]\n"
                tempBuf += "      }\n"
            } else {
                // Single-select enumeration -> String with allowed choices
                tempBuf += "      \"type\": \"string\",\n"
                tempBuf += "      \"enum\": ["
                
                int i
                for (i = 0; i < at.size; i++) {
                    if (i > 0) { tempBuf += ", " }
                    tempBuf += "\""
                    tempBuf += at.strings[i]
                    tempBuf += "\""
                }
                
                // Explicitly add the empty string for unassigned attributes
                tempBuf += ", \"\"]\n"
            }
            
        } else {
            // Normal types (Integers, standard Strings, Text)
            // DOORS attributes are often empty, so allow null for everything
            tempBuf += "      \"type\": [\""
            tempBuf += jsonType
            tempBuf += "\", \"null\"]\n"
        }
        
        tempBuf += "    }"
        
        outStream << tempBuf
        setempty(tempBuf)
    }
}

// --- Static definitions for in_links and out_links ---
tempBuf += ",\n"

// out_links schema definition
tempBuf += "    \"out_links\": {\n"
tempBuf += "      \"type\": [\"array\", \"null\"],\n"
tempBuf += "      \"items\": {\n"
tempBuf += "        \"type\": \"object\",\n"
tempBuf += "        \"properties\": {\n"
tempBuf += "          \"link_module\": {\"type\": [\"string\", \"null\"]},\n"
tempBuf += "          \"target_module\": {\"type\": [\"string\", \"null\"]},\n"
tempBuf += "          \"target_id\": {\"type\": [\"integer\", \"null\"]}\n"
tempBuf += "        }\n"
tempBuf += "      }\n"
tempBuf += "    },\n"

// in_links schema definition
tempBuf += "    \"in_links\": {\n"
tempBuf += "      \"type\": [\"array\", \"null\"],\n"
tempBuf += "      \"items\": {\n"
tempBuf += "        \"type\": \"object\",\n"
tempBuf += "        \"properties\": {\n"
tempBuf += "          \"link_module\": {\"type\": [\"string\", \"null\"]},\n"
tempBuf += "          \"source_module\": {\"type\": [\"string\", \"null\"]},\n"
tempBuf += "          \"source_id\": {\"type\": [\"integer\", \"null\"]}\n"
tempBuf += "        }\n"
tempBuf += "      }\n"
tempBuf += "    }\n"


// Close the main properties and object
tempBuf += "  }\n}\n"
outStream << tempBuf

delete(tempBuf)
close(outStream)

// Clean up by closing the module when finished
close(m)

halt